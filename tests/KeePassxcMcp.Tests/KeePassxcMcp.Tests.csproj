<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KeePassxcMcp\KeePassxcMcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- e2e tests spawn the real built executable (mcp + promote modes). -->
  <Target Name="CopyServerApp" AfterTargets="Build">
    <ItemGroup>
      <ServerAppFiles Include="$(MSBuildProjectDirectory)\..\..\src\KeePassxcMcp\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ServerAppFiles)"
          DestinationFolder="$(OutDir)serverapp\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

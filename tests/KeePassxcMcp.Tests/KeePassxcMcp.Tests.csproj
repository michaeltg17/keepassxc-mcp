<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3: suppress the runner's app entrypoint; the test host drives it. -->
    <GenerateProgram>false</GenerateProgram>
    <!-- .NET 11 SDK: VSTest is retired; global.json selects the MTP runner. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KeePassxcMcp\KeePassxcMcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- e2e tests spawn the real built executable (mcp + promote modes). -->
  <Target Name="CopyServerApp" AfterTargets="Build">
    <ItemGroup>
      <ServerAppFiles Include="$(MSBuildProjectDirectory)\..\..\src\KeePassxcMcp\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ServerAppFiles)"
          DestinationFolder="$(OutDir)serverapp\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
